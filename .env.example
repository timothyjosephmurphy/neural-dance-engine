# Neural Dance Engine — optional secrets for Cloudflare Workers
# Do not commit real secrets or a populated .env file.
# Set Worker secrets in Cloudflare via Wrangler:
#
#   npx wrangler secret put SIM_PARAMS_TOKEN --config wrangler.sim.toml
#
# Optional (only needed if enabling live X move requests on the debug room):
#   npx wrangler secret put X_BEARER_TOKEN --config wrangler.toml
#   npx wrangler secret put X_USER_ACCESS_TOKEN --config wrangler.toml
#
SIM_PARAMS_TOKEN=
X_BEARER_TOKEN=
X_USER_ACCESS_TOKEN=
